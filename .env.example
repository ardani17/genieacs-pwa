# Deployment environment template — placeholders only, never real
# credentials. Copy to .env and fill in; .env is git-ignored.

# MongoDB (bootstrap admin user; must match GENIEACS_MONGODB_CONNECTION_URL
# requirements — the engine uses these to reach the database).
MONGO_USERNAME=genieacs
MONGO_PASSWORD=change-me-strong-password
MONGO_DATABASE=genieacs

# Engine UI session signing secret (dashboard login).
GENIEACS_UI_JWT_SECRET=change-me-random-long-secret

# Image labels.
APP_VERSION=dev
SOURCE_COMMIT=unknown

# Host binds. Web defaults to loopback; put an HTTPS overlay (compose
# -f compose.yaml -f compose.https.yaml) in front for remote access.
WEB_BIND=127.0.0.1:3000
CWMP_BIND=7547
FS_BIND=7567

# Public origin the browser uses to reach the dashboard (scheme://host,
# no trailing slash). Must match the certificate when HTTPS is enabled.
PUBLIC_ORIGIN=http://localhost:3000

# L2TP stage 1: name of the bootstrap xl2tpd profile mounted by the
# operator (empty = vpn stays "not-configured"). Persistent management
# arrives with M07-A.
VPN_PROFILE=

# HTTPS overlay mounts (compose.https.yaml).
HTTPS_BIND=0.0.0.0:443
HTTPS_CERT_FILE=/path/to/tls.crt
HTTPS_KEY_FILE=/path/to/tls.key
